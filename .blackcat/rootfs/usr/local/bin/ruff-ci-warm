#!/bin/bash
# Toolchain, sources and a warm build of everything the Linux CI jobs compile
# (uid 1000, template build VM only).
set -euxo pipefail
SECONDS=0
curl -fsSL --retry 5 https://sh.rustup.rs | sh -s -- -y --profile minimal \
  --default-toolchain 1.99.0 --component clippy --component rustfmt
git init -q /workspace/ruff && cd /workspace/ruff
git remote add origin https://github.com/TreebeardHQ/ruff.git
git fetch -q --depth=1 origin "$(cat /etc/ruff-ci/sha)" && git checkout -q FETCH_HEAD
cargo fetch --locked
uv python install "$PYTHON_VERSION"
uv sync --only-dev
echo "setup done at ${SECONDS}s"
time cargo nextest run --all-features --no-run --cargo-quiet
echo "tests built at ${SECONDS}s"
time cargo build -p ty
time cargo clippy --workspace --all-targets --all-features --locked
echo "clippy built at ${SECONDS}s"
curl -fsSL --retry 5 "https://github.com/astral-sh/hawk/releases/download/${HAWK_VERSION}/cargo-hawk-installer.sh" | sh
# Stock hawk re-checks every crate on every run (its run id is tracked in
# each crate's dep-info), so a warm target/hawk saves nothing; skip it.
msrv=$(sed -n 's/^rust-version = "\(.*\)"/\1/p' Cargo.toml | head -1)
rustup toolchain install "$msrv" --profile minimal
rustup target add wasm32-unknown-unknown
# The MSRV build is not warmed: its artifacts would crowd hawk out of the
# fixed writable disk, and its own job is far from the critical path.
time cargo clippy -p ruff_wasm -p ty_wasm --target wasm32-unknown-unknown --all-features --locked
(cd crates/ruff_wasm && time wasm-pack test --node)
(cd crates/ty_wasm && time wasm-pack test --node)
echo "wasm built at ${SECONDS}s"
uv sync --only-group docs
uv sync --only-dev
uv tool install maturin
SKIP=rustfmt uv run --only-dev --locked prek run --all-files --hook-stage manual || true
echo "tools warmed at ${SECONDS}s"
du -sh target "$CARGO_HOME" "$RUSTUP_HOME" "$UV_CACHE_DIR" || true
df -h /
